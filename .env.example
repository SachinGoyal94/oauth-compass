# Copy to .env and fill in your own values. Never commit .env.

# NVIDIA NIM — https://build.nvidia.com (required for live guide generation)
NVIDIA_API_KEY=nvapi-...

# Composio — https://dashboard.composio.dev -> Settings (required for toolkit
# catalog sync + Composio Search web tools used by the generation crew)
COMPOSIO_API_KEY=...

# Any stable user id for Composio sessions
COMPOSIO_USER_ID=oauth-guide-builder

# Optional overrides
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
APP_HOST=127.0.0.1
APP_PORT=8000
